import { ScrollView, Slider, Button, CheckBox, LineEdit } from "std-widgets.slint";

export struct TableCell {
    text: string,
}

export struct TableRow {
    cells: [TableCell],
    header: bool,
}

export struct Block {
    kind: int,
    level: int,
    styled: styled-text,
    text: string,
    image: image,
    has-image: bool,
    table: [TableRow],
}

component ColorChannels inherits VerticalLayout {
    in property <string> name;
    in property <color> text-color;
    in-out property <float> r;
    in-out property <float> g;
    in-out property <float> b;
    callback changed;

    alignment: start;
    spacing: 2px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.name;
            color: root.text-color;
            vertical-alignment: center;
        }
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 3px;
            border-width: 1px;
            border-color: #808080;
            background: rgb(root.r, root.g, root.b);
        }
    }
    HorizontalLayout {
        spacing: 4px;
        Slider {
            value: root.r;
            minimum: 0;
            maximum: 255;
            changed => {
                root.r = self.value;
                root.changed();
            }
        }
        Slider {
            value: root.g;
            minimum: 0;
            maximum: 255;
            changed => {
                root.g = self.value;
                root.changed();
            }
        }
        Slider {
            value: root.b;
            minimum: 0;
            maximum: 255;
            changed => {
                root.b = self.value;
                root.changed();
            }
        }
    }
}

component SelectableText inherits TextInput {
    in property <color> text-color: #000000;
    in property <color> selection-color: #4f7bd0;
    in property <length> text-size: 16px;
    in property <string> text-family: "";
    in property <int> weight: 400;
    // The code block underlay renders the text; the input on top only shows
    // the selection, so its own text must stay invisible.
    in property <bool> hide-text: false;

    width: 100%;
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    // A viewer has nothing to type, so don't show a blinking caret.
    text-cursor-width: 0px;
    color: hide-text ? transparent : text-color;
    selection-background-color: selection-color;
    selection-foreground-color: hide-text ? transparent : text-color;
    font-size: text-size;
    font-family: text-family;
    font-weight: weight;
}

// Renders rich inline markdown (emphasis, strikethrough, code, links,
// underline) with an invisible text input on top so it stays selectable.
component RichText inherits Rectangle {
    in property <string> plain;
    in property <styled-text> styled;
    in property <color> text-color: #000000;
    in property <color> link-color: #4f7bd0;
    in property <color> selection-color: #4f7bd0;
    in property <length> text-size: 16px;
    in property <string> text-family: "";
    in property <int> weight: 400;

    width: 100%;
    height: rich.preferred-height;

    rich := StyledText {
        x: 0;
        y: 0;
        width: parent.width;
        text: root.styled;
        default-color: root.text-color;
        default-font-family: root.text-family;
        default-font-size: root.text-size;
        link-color: root.link-color;
    }

    SelectableText {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.plain;
        hide-text: true;
        text-color: root.text-color;
        selection-color: root.selection-color;
        text-size: root.text-size;
        text-family: root.text-family;
        weight: root.weight;
    }
}

export component AppWindow inherits Window {
    in property <[Block]> blocks;
    in property <string> doc-title: "lantai";

    in-out property <length> font-size: 19px;
    in-out property <bool> dark: true;
    in-out property <bool> custom-fg: false;
    in-out property <bool> custom-bg: false;
    in-out property <float> fg-r: 212;
    in-out property <float> fg-g: 212;
    in-out property <float> fg-b: 212;
    in-out property <float> bg-r: 0;
    in-out property <float> bg-g: 0;
    in-out property <float> bg-b: 0;
    in-out property <float> accent-r: 79;
    in-out property <float> accent-g: 123;
    in-out property <float> accent-b: 208;
    in-out property <bool> settings-open: false;
    in-out property <bool> search-open: false;
    in-out property <string> search-query: "";
    in-out property <string> search-status: "";
    in-out property <int> measure-tick: 0;

    property <length> line-step: root.font-size * 1.5;

    // Sampling block positions has to happen after layout, hence the timer.
    measure-timer := Timer {
        interval: 30ms;
        running: false;
        triggered => {
            measure-tick += 1;
            self.running = false;
        }
    }

    function refresh-block-positions() {
        if !measure-timer.running {
            measure-timer.running = true;
        }
    }

    changed blocks => {
        refresh-block-positions();
    }
    changed width => {
        refresh-block-positions();
    }
    changed height => {
        refresh-block-positions();
    }
    changed font-size => {
        refresh-block-positions();
    }

    // Keeps the content-y offset between the top (0) and the bottom.
    function max-scroll() -> length {
        return max(scroll.content-height - scroll.visible-height, 0px);
    }

    public function scroll-down() {
        scroll.content-y = max(scroll.content-y - line-step, -max-scroll());
    }

    public function scroll-up() {
        scroll.content-y = min(scroll.content-y + line-step, 0px);
    }

    public function scroll-half-page-down() {
        let half-page = scroll.visible-height / 2;
        scroll.content-y = max(scroll.content-y - half-page, -max-scroll());
    }

    public function scroll-half-page-up() {
        let half-page = scroll.visible-height / 2;
        scroll.content-y = min(scroll.content-y + half-page, 0px);
    }

    public function scroll-to-top() {
        scroll.content-y = 0px;
    }

    public function scroll-to-bottom() {
        scroll.content-y = -max-scroll();
    }

    public function scroll-to-position(y: length) {
        scroll.content-y = clamp(-y, -max-scroll(), 0px);
    }

    public function open-search() {
        search-query = "";
        search-status = "";
        search-open = true;
    }

    public function close-search() {
        search-open = false;
        search-status = "";
        keys.focus();
    }

    pure function alert-label(level: int) -> string {
        if level == 1 { return "Note"; }
        if level == 2 { return "Tip"; }
        if level == 3 { return "Important"; }
        if level == 4 { return "Warning"; }
        return "Caution";
    }

    pure function alert-color(level: int) -> color {
        if level == 1 { return #3b82f6; }
        if level == 2 { return #22c55e; }
        if level == 3 { return #a855f7; }
        if level == 4 { return #f59e0b; }
        return #ef4444;
    }

    callback settings-changed;
    callback reload-requested;
    callback open-link(string);
    callback quit-requested;
    callback search-requested(string, bool);
    callback block-positioned(int, length);

    property <color> fg: custom-fg ? rgb(fg-r, fg-g, fg-b) : (dark ? #d4d4d4 : #242424);
    property <color> bg: custom-bg ? rgb(bg-r, bg-g, bg-b) : (dark ? #000000 : #ffffff);
    property <color> accent: rgb(accent-r, accent-g, accent-b);
    property <color> selection: accent.with-alpha(0.4);
    property <color> code-bg: dark ? bg.brighter(0.14) : bg.darker(0.06);
    property <color> panel-bg: dark ? #1e1e1e : #f2f2f2;
    property <color> border: fg.mix(bg, 0.75);

    title: doc-title;
    background: bg;
    default-font-size: font-size;
    forward-focus: keys;

    keys := FocusScope {
        property <bool> pending-g: false;

        key-pressed(event) => {
            if (root.search-open) {
                if (event.text == Key.Escape) {
                    root.close-search();
                    accept
                } else {
                    reject
                }
            } else if (event.modifiers.control && event.text == "d") {
                pending-g = false;
                root.scroll-half-page-down();
                accept
            } else if (event.modifiers.control && event.text == "u") {
                pending-g = false;
                root.scroll-half-page-up();
                accept
            } else if (event.text == "q") {
                pending-g = false;
                root.quit-requested();
                accept
            } else if (event.text == "j") {
                pending-g = false;
                root.scroll-down();
                accept
            } else if (event.text == "k") {
                pending-g = false;
                root.scroll-up();
                accept
            } else if (event.text == "G") {
                pending-g = false;
                root.scroll-to-bottom();
                accept
            } else if (event.text == "g") {
                if (pending-g) {
                    pending-g = false;
                    root.scroll-to-top();
                } else {
                    pending-g = true;
                }
                accept
            } else if (event.text == "/") {
                pending-g = false;
                root.open-search();
                accept
            } else if (event.text == Key.F5) {
                pending-g = false;
                root.reload-requested();
                accept
            } else {
                pending-g = false;
                reject
            }
        }

        scroll := ScrollView {
            width: 100%;
            height: 100%;
            // Keep the content sized to the visible viewport so wrapped text
            // never overflows sideways and no horizontal scrollbar shows up.
            content-width: self.visible-width;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            VerticalLayout {
                width: root.width;
                alignment: start;
                padding: 18px;
                spacing: 10px;

                for block[index] in blocks: VerticalLayout {
                    alignment: start;
                    // Layout geometry changes don't emit change notifications,
                    // so sample each block's position whenever the root asks
                    // for a fresh measurement (after load, resize, font change).
                    property <int> measure: root.measure-tick;
                    changed measure => {
                        root.block-positioned(index, self.y);
                    }

                    if block.kind == 1: RichText {
                        plain: block.text;
                        styled: block.styled;
                        text-color: root.fg;
                        link-color: root.accent;
                        selection-color: root.selection;
                        text-size: root.font-size * (block.level <= 1 ? 1.7 : block.level == 2 ? 1.45 : 1.2);
                        weight: 700;
                    }
                    if block.kind == 2: Rectangle {
                        background: root.code-bg;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            alignment: start;
                            Rectangle {
                                // The highlighted text defines the height; the
                                // transparent input on top handles selection.
                                height: code-text.preferred-height;
                                code-text := StyledText {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    text: block.styled;
                                    default-color: root.fg;
                                    default-font-family: "monospace";
                                    default-font-size: root.font-size * 0.92;
                                }
                                SelectableText {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: block.text;
                                    hide-text: true;
                                    selection-color: root.selection;
                                    text-size: root.font-size * 0.92;
                                    text-family: "monospace";
                                }
                            }
                        }
                    }
                    if block.kind == 3: RichText {
                        plain: block.text;
                        styled: block.styled;
                        text-color: root.fg;
                        link-color: root.accent;
                        selection-color: root.selection;
                        text-size: root.font-size;
                    }
                    if block.kind == 4: Rectangle {
                        background: transparent;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            Rectangle {
                                width: 3px;
                                background: root.accent;
                            }
                            RichText {
                                width: parent.width - 13px;
                                plain: block.text;
                                styled: block.styled;
                                text-color: root.fg.mix(root.bg, 0.3);
                                link-color: root.accent;
                                selection-color: root.selection;
                                text-size: root.font-size;
                            }
                        }
                    }
                    if block.kind == 8: Rectangle {
                        background: root.code-bg;
                        border-radius: 6px;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            Rectangle {
                                width: 3px;
                                background: root.alert-color(block.level);
                            }
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                alignment: start;
                                Text {
                                    text: root.alert-label(block.level);
                                    color: root.alert-color(block.level);
                                    font-size: root.font-size * 0.92;
                                    font-weight: 700;
                                }
                                RichText {
                                    plain: block.text;
                                    styled: block.styled;
                                    text-color: root.fg;
                                    link-color: root.accent;
                                    selection-color: root.selection;
                                    text-size: root.font-size;
                                }
                            }
                        }
                    }
                    if block.kind == 5: Rectangle {
                        height: 1px;
                        background: root.border;
                    }
                    if block.kind == 6: Rectangle {
                        // The grid itself draws the cell separators, so use
                        // the border color as background and leave 1px gaps.
                        background: root.border;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 1px;
                            alignment: start;
                            GridLayout {
                                spacing: 1px;
                                for row in block.table: Row {
                                    for cell in row.cells: Rectangle {
                                        background: row.header ? root.code-bg : root.bg;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 5px;
                                            padding-bottom: 5px;
                                            Text {
                                                text: cell.text;
                                                color: root.fg;
                                                font-size: root.font-size * 0.92;
                                                font-weight: row.header ? 700 : 400;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                                min-width: 0px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if block.kind == 7 && block.has-image: Image {
                        source: block.image;
                        image-fit: contain;
                        max-height: 640px;
                    }
                    if block.kind == 9: RichText {
                        plain: block.text;
                        styled: block.styled;
                        text-color: root.fg.mix(root.bg, 0.35);
                        link-color: root.accent;
                        selection-color: root.selection;
                        text-size: root.font-size * 0.92;
                    }
                    if block.kind == 0: RichText {
                        plain: block.text;
                        styled: block.styled;
                        text-color: root.fg;
                        link-color: root.accent;
                        selection-color: root.selection;
                        text-size: root.font-size;
                    }
                }
            }
        }
    }

    Rectangle {
        x: root.width - self.width - 14px;
        y: 14px;
        width: 38px;
        height: 38px;
        border-radius: 19px;
        background: root.panel-bg;
        border-width: 1px;
        border-color: root.border;
        Text {
            text: "⚙";
            color: root.fg;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.settings-open = !root.settings-open;
            }
        }
    }

    if root.settings-open: Rectangle {
        x: root.width - self.width;
        y: 0;
        width: 330px;
        height: root.height;
        background: root.panel-bg;
        border-width: 1px;
        border-color: root.border;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Settings";
                    color: root.fg;
                    font-size: root.font-size * 1.3;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Close";
                    clicked => {
                        root.settings-open = false;
                    }
                }
            }

            Text {
                text: "Font size: " + round(root.font-size / 1px) + " px";
                color: root.fg;
            }
            Slider {
                value: root.font-size / 1px;
                minimum: 8;
                maximum: 48;
                changed => {
                    root.font-size = self.value * 1px;
                    root.settings-changed();
                }
            }

            Text {
                text: "Theme";
                color: root.fg;
            }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: "Dark";
                    checkable: true;
                    checked: root.dark;
                    clicked => {
                        root.dark = true;
                        root.settings-changed();
                    }
                }
                Button {
                    text: "Light";
                    checkable: true;
                    checked: !root.dark;
                    clicked => {
                        root.dark = false;
                        root.settings-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Reload";
                    clicked => {
                        root.reload-requested();
                    }
                }
            }

            CheckBox {
                text: "Custom text color";
                checked: root.custom-fg;
                toggled => {
                    root.custom-fg = self.checked;
                    root.settings-changed();
                }
            }
            if root.custom-fg: ColorChannels {
                name: "Text RGB";
                text-color: root.fg;
                r: root.fg-r;
                g: root.fg-g;
                b: root.fg-b;
                changed => {
                    root.fg-r = self.r;
                    root.fg-g = self.g;
                    root.fg-b = self.b;
                    root.settings-changed();
                }
            }

            CheckBox {
                text: "Custom background";
                checked: root.custom-bg;
                toggled => {
                    root.custom-bg = self.checked;
                    root.settings-changed();
                }
            }
            if root.custom-bg: ColorChannels {
                name: "Background RGB";
                text-color: root.fg;
                r: root.bg-r;
                g: root.bg-g;
                b: root.bg-b;
                changed => {
                    root.bg-r = self.r;
                    root.bg-g = self.g;
                    root.bg-b = self.b;
                    root.settings-changed();
                }
            }

            ColorChannels {
                name: "Accent RGB";
                text-color: root.fg;
                r: root.accent-r;
                g: root.accent-g;
                b: root.accent-b;
                changed => {
                    root.accent-r = self.r;
                    root.accent-g = self.g;
                    root.accent-b = self.b;
                    root.settings-changed();
                }
            }
        }
    }

    if root.search-open: Rectangle {
        x: (root.width - self.width) / 2;
        y: 14px;
        width: min(root.width - 28px, 560px);
        height: 48px;
        background: root.panel-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.border;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 8px;

            Text {
                text: "/";
                color: root.fg;
                font-size: root.font-size;
                vertical-alignment: center;
            }

            search-input := LineEdit {
                text <=> root.search-query;
                placeholder-text: "Search";
                accepted(text) => {
                    root.search-requested(text, true);
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.close-search();
                        accept
                    } else {
                        reject
                    }
                }
                init => {
                    self.focus();
                }
            }

            Text {
                text: root.search-status;
                color: root.fg.mix(root.bg, 0.4);
                font-size: root.font-size * 0.85;
                vertical-alignment: center;
                visible: !root.search-status.is-empty;
            }

            Button {
                text: "✕";
                clicked => {
                    root.close-search();
                }
            }
        }
    }
}
